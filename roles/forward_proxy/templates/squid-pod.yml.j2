---
apiVersion: v1
kind: Pod
metadata:
  name: {{ forward_proxy_unit_name }}
  labels:
    io.lightning-it.owner: lit.supplementary.forward_proxy
spec:
  hostNetwork: true
  restartPolicy: Always
  terminationGracePeriodSeconds: 30
  initContainers:
    - name: prepare-squid-tmp
      image: {{ forward_proxy_image }}
      imagePullPolicy: {{ forward_proxy_image_pull_policy }}
      command:
        - /bin/sh
        - -c
      args:
        - chmod 1777 /squid-tmp
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        privileged: false
        capabilities:
          drop:
            - ALL
      volumeMounts:
        - name: squid-tmp
          mountPath: /squid-tmp
  containers:
    - name: squid
      image: {{ forward_proxy_image }}
      imagePullPolicy: {{ forward_proxy_image_pull_policy }}
      command:
        - /usr/sbin/squid
      args:
        - -f
        - /etc/squid/squid.conf
        - -NYC
      securityContext:
        runAsUser: {{ forward_proxy_runtime_uid }}
        runAsGroup: {{ forward_proxy_runtime_gid }}
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        privileged: false
        capabilities:
          drop:
            - ALL
      livenessProbe:
        exec:
          command:
            - /bin/bash
            - -ec
            - |-
              exec 3<>/dev/tcp/127.0.0.1/{{ forward_proxy_port }}
              printf 'GET http://health.invalid/ HTTP/1.0\r\nHost: health.invalid\r\n\r\n' >&3
              IFS= read -r status <&3
              [[ "${status}" == HTTP/* ]]
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 3
        failureThreshold: 3
      volumeMounts:
        - name: squid-config
          mountPath: /etc/squid/squid.conf
          readOnly: true
        - name: squid-tmp
          mountPath: /tmp
  volumes:
    - name: squid-config
      hostPath:
        path: {{ forward_proxy_config_path }}
        type: File
      selinuxRelabel: true
    - name: squid-tmp
      emptyDir: {}
