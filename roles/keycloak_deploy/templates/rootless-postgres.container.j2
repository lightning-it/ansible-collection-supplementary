[Unit]
Description=Rootless PostgreSQL for Keycloak
[Container]
Image={{ keycloak_deploy_postgres_image }}
ContainerName=postgres
Network=keycloak-private.network
IP={{ keycloak_deploy_rootless_postgres_ip }}
EnvironmentFile={{ keycloak_deploy_config_dir }}/rootless-postgres.env
Volume={{ keycloak_deploy_postgres_data_dir }}:/var/lib/postgresql/data:Z,U
[Service]
Restart=on-failure
TimeoutStartSec=900
[Install]
WantedBy=default.target
