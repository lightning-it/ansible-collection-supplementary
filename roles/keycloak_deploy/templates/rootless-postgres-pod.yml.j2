apiVersion: v1
kind: Pod
metadata:
  name: {{ keycloak_deploy_postgres_pod_name | to_json }}
spec:
  containers:
    - name: {{ keycloak_deploy_postgres_container_name | to_json }}
      image: {{ keycloak_deploy_postgres_image | to_json }}
      env:
        - name: POSTGRES_DB
          value: {{ keycloak_deploy_db_name | to_json }}
        - name: POSTGRES_USER
          value: {{ keycloak_deploy_db_user | to_json }}
        - name: POSTGRES_PASSWORD
          value: {{ keycloak_deploy_db_password | to_json }}
      volumeMounts:
        - name: postgres-data
          mountPath: /var/lib/postgresql/data
  volumes:
    - name: postgres-data
      hostPath:
        path: {{ keycloak_deploy_postgres_data_dir | to_json }}
        type: Directory
      selinuxRelabel: true
