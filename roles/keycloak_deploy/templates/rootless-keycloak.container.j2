[Unit]
Description=Rootless Keycloak
Requires=postgres.service
After=postgres.service
[Container]
Image={{ keycloak_deploy_image }}
ContainerName=keycloak
Network=keycloak-private.network
IP={{ keycloak_deploy_rootless_keycloak_ip }}
EnvironmentFile={{ keycloak_deploy_config_dir }}/rootless-keycloak.env
Volume={{ keycloak_deploy_host_data_dir }}:/opt/keycloak/data:Z,U
{% if keycloak_deploy_rootless_publish_management %}
PublishPort=127.0.0.1:9000:9000
{% endif %}
Exec=start
[Service]
Restart=on-failure
TimeoutStartSec=900
[Install]
WantedBy=default.target
