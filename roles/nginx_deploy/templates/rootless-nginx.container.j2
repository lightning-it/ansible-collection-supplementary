[Unit]
Description=Rootless Nginx reverse proxy
Requires=keycloak.service
After=keycloak.service
[Container]
Image={{ nginx_deploy_image }}
ContainerName=nginx
Network=keycloak-private.network
IP={{ nginx_deploy_rootless_ip }}
PublishPort={{ nginx_deploy_host_ip }}:{{ nginx_deploy_tls_host_port }}:8443
Volume={{ nginx_deploy_host_conf_file }}:/etc/nginx/nginx.conf:ro,Z
Volume={{ nginx_deploy_rootless_tls_cert }}:/etc/nginx/tls/server.crt:ro,Z
Volume={{ nginx_deploy_rootless_tls_key }}:/etc/nginx/tls/server.key:ro,Z
[Service]
Restart=on-failure
TimeoutStartSec=900
[Install]
WantedBy=default.target
