{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightning-it/shared-assets-lit/ansible-collection/quality-policy/quality-policy.schema.json",
  "title": "Lightning IT quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle", "archetype", "policy", "profiles", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "lifecycle": {"const": "active"},
    "archetype": {"const": "ansible-collection"},
    "policy": {"$ref": "#/$defs/policy"},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Static", "Build", "Unit", "Contract", "Tiny", "Heavy", "Application Acceptance"],
      "properties": {
        "Static": {"$ref": "#/$defs/profile"},
        "Build": {"$ref": "#/$defs/profile"},
        "Unit": {"$ref": "#/$defs/profile"},
        "Contract": {"$ref": "#/$defs/profile"},
        "Tiny": {"$ref": "#/$defs/profile"},
        "Heavy": {"$ref": "#/$defs/profile"},
        "Application Acceptance": {"$ref": "#/$defs/profile"}
      }
    },
    "exceptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exception"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_hours", "related_adrs", "branch_aggregates"],
      "properties": {
        "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 36},
        "related_adrs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "branch_aggregates": {"$ref": "#/$defs/branchAggregates"}
      }
    },
    "branchAggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["develop", "main"],
      "properties": {
        "develop": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/aggregate"}},
        "main": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/aggregate"}}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profiles", "evidence_verifier"],
      "properties": {
        "name": {"enum": ["Collection / Fast", "Collection / Release Evidence"]},
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["Static", "Build", "Unit", "Contract", "Tiny", "Heavy", "Application Acceptance"]}
        },
        "evidence_verifier": {"type": "boolean"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "executor", "triggers", "blocking", "evidence"],
      "properties": {
        "owner": {"enum": ["source-repository", "modulix-validation"]},
        "executor": {"enum": ["source-repository", "modulix-validation"]},
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pull_request", "nightly", "manual"]}
        },
        "blocking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["develop", "main"],
          "properties": {"develop": {"type": "boolean"}, "main": {"type": "boolean"}}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidate_bound", "retention_days"],
          "properties": {
            "kind": {"enum": ["source-check", "central-validation"]},
            "candidate_bound": {"type": "boolean"},
            "retention_days": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "reason", "owner", "approver", "adr", "compensating_controls", "start", "expires", "review"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "adr": {"type": "string", "format": "uri"},
        "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "start": {"type": "string", "format": "date"},
        "expires": {"type": "string", "format": "date"},
        "review": {"type": "string", "format": "date"}
      }
    }
  }
}
